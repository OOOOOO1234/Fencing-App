# Local Vite only. Analysis secrets do NOT go here as VITE_*.
# On Netlify, set server env for the analyze function (see docs/env.md).

# --- Optional cloud sync (not required for single-page Moneyball) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only (Netlify → Environment variables, NOT VITE_) ---
# OPENAI_API_KEY=           # preferred for /.netlify/functions/analyze
# ANALYSIS_API_KEY=         # alternate name
# OPENAI_ANALYSIS_MODEL=gpt-4o
#
# Transition: if OPENAI_API_KEY is unset, the function may read VITE_ANALYSIS_API_KEY
# from the function runtime — but never put the OpenAI secret in client code.
# Prefer renaming/copying the secret to OPENAI_API_KEY and removing VITE_ANALYSIS_API_KEY.
