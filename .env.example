# Fencing-App — paste into local `.env` and/or Netlify → Site settings → Environment variables
# Then rebuild/redeploy. The app runs fully in local/demo mode with all of these blank.

# --- Cloud sync / accounts (Supabase) ---
# Create a free project at https://supabase.com , run the SQL in src/lib/supabase.ts (SUPABASE_SCHEMA_SQL),
# then paste:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI analysis provider ---
# HTTP endpoint that accepts POST JSON:
#   { boutId, side, title, videoUrl, weapon: "sabre", actions: string[] }
# and returns:
#   { phrases: [{ timestamp, action, outcome, remark?, confidence? }] }
# Authorization: Bearer <key>
VITE_ANALYSIS_API_URL=
VITE_ANALYSIS_API_KEY=

# No other secrets are required for the public demo (manual tagging + IndexedDB).
